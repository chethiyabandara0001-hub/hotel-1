# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN CREDENTIALS: Used to authenticate into the /admin dashboard.
ADMIN_EMAIL="admin@saltandstone.lk"
ADMIN_PASSWORD="saltandstone2026"
ADMIN_SESSION_SECRET="replace_with_strong_random_session_secret"

# PAYMENT GATEWAY (PayHere Sri Lanka / Stripe)
# Leave empty until merchant credentials are supplied. When unconfigured, live online card checkout is disabled and clearly labeled.
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_SANDBOX="true"

# TRANSACTIONAL EMAIL PROVIDER (Resend HTTP API)
# Leave empty until email domain credentials are supplied.
RESEND_API_KEY=""
EMAIL_FROM="Salt & Stone Coastal House <reservations@saltandstone.lk>"
